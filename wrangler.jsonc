/**
 * Wrangler configuration for the Digital Public Service Assistant 2030 template.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * After changing bindings, run `pnpm cf-typegen` to regenerate the `Env` types.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gov-assistant-2030",
	// Team account (Martin's, has the Workers AI credits). Everyone's wrangler login must have access to it.
	"account_id": "4467250ff4138321896264140dca6da8",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	// Workers AI – used for the chat agent.
	"ai": {
		"binding": "AI"
	},

	// D1 – the mock e-government database (synthetic citizens, applications, appointments).
	// No database_id needed: Wrangler creates the database automatically on first deploy.
	// The tables are created and filled automatically on the first request (see src/gov/db.ts).
	"d1_databases": [
		{
			"binding": "GOV_DB",
			"database_name": "gov-assistant-mock-db"
		}
	],

	// Durable Object – one chat agent instance per browser session (stores the conversation).
	"durable_objects": {
		"bindings": [
			{
				"name": "CitizenAssistant",
				"class_name": "CitizenAssistant"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["CitizenAssistant"]
		}
	],

	// Static assets – the React frontend (built by Vite). API and agent routes run in the Worker first.
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*", "/agents/*"]
	},

	// Mock backend behaviour – use these to test how your assistant handles slow or failing services.
	"vars": {
		"MOCK_FAILURE_RATE": "0",
		"MOCK_LATENCY_MS": "0"
	}
}
