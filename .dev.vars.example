# Copy to .dev.vars (git-ignored) for local development.
# Deployed worker: npx wrangler secret put ELEVENLABS_API_KEY
# Without a key, the app falls back to the browser's built-in speech.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional: a voice id from your ElevenLabs voice library
ELEVENLABS_VOICE_ID=your_voice_id_here
# Optional: Google Maps key with "Places API (New)" enabled (address suggestions + check).
# Without a key, address fields are plain text fields. Deployed: npx wrangler secret put GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_API_KEY=
